<Project>
  <!-- Versiones exactas de docs/DOC_TECNICA.md §2 (consultadas el 14/10/2026).
       Gestión centralizada: cambiar una versión aquí obliga a justificarlo en DOC_TECNICA §2. -->
  <ItemGroup>
    <!-- ASP.NET Core / EF Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Serilog -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Autenticación (F1-04): JWT de acceso en cookie y hash de contraseñas -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
    <!-- F1-06: TOTP del segundo factor. El QR lo dibuja el frontend; aquí no hay librería de imagen. -->
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <!-- F1-12: disparo de los jobs diarios. Hangfire.AspNetCore integra el servidor de jobs con
         la API; Hangfire.PostgreSql es el almacenamiento (docs/DOC_TECNICA.md §2 y §8). -->
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- F1-12: Hangfire.Core 1.8.25 declara Newtonsoft.Json 11.0.1, con CVE-2024-21907 (alta,
         denegación de servicio por JSON anidado). Se fija la versión parcheada que ya resolutions
         el proyecto de la API por EF Core, para que ningún proyecto quede con la vulnerable. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- F2-02: PDF por código, sin HTML (docs/DESIGN.md §7). Licencia Community: no pide clave ni contacto. -->
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>
</Project>