<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AtlasRent.Api</RootNamespace>
    <AssemblyName>AtlasRent.Api</AssemblyName>
    <!-- Credenciales de desarrollo en user-secrets (AGENTS.md §9); nunca en el repositorio -->
    <UserSecretsId>atlas-rent-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Fijado aquí para que la API y los tests resuelvan la misma versión de EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- F1-04: validación del JWT de acceso (viene en cookie) y hash de contraseñas -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="BCrypt.Net-Next" />
    <!-- F1-06: segundo factor TOTP -->
    <PackageReference Include="Otp.NET" />
    <!-- F1-12: servidor de jobs y su almacenamiento en PostgreSQL (DOC_TECNICA §8) -->
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- F1-12: fija la versión parcheada de Newtonsoft.Json para todo el grafo (ver
         Directory.Packages.props): Hangfire arrastra la 11.0.1, con CVE-2024-21907. -->
    <PackageReference Include="Newtonsoft.Json" />
    <!-- F2-02: PDF de cotizaciones por código (docs/DESIGN.md §7) -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AtlasRent.Tests" />
  </ItemGroup>

  <!--
    F1-13: el paquete de despliegue tiene que llevar la interfaz. DOC_TECNICA §1 dice que la API
    sirve el frontend como estático desde wwwroot y §9.3 mete "frontend compilado" en el ZIP, pero
    nada ponía la una cosa donde la otra la lee: vite escribía en frontend/dist y la API buscaba
    wwwroot. Este target es ese "nada".

    Va en Publish y no en Build a propósito: compilar en desarrollo y ejecutar los tests de
    integración no debe depender de que el frontend esté construido, y los tests comparten el
    directorio de salida, así que meter el build ahí dentro les cambiaría el comportamiento de las
    rutas sin entrada.
  -->
  <PropertyGroup>
    <AtlasRentFrontendDist>$(MSBuildProjectDirectory)/../../frontend/dist</AtlasRentFrontendDist>
  </PropertyGroup>

  <Target Name="AtlasRentAvisarSiNoHayFrontend" AfterTargets="ComputeFilesToPublish">
    <Message Importance="high"
             Condition="!Exists('$(AtlasRentFrontendDist)/index.html')"
             Text="AVISO: no hay frontend compilado en '$(AtlasRentFrontendDist)'. El paquete se publica SIN interfaz. Ejecuta 'npm ci &amp;&amp; npm run build' en frontend/ antes de publicar." />
  </Target>

  <Target Name="AtlasRentPublicarFrontend" AfterTargets="Publish"
          Condition="Exists('$(AtlasRentFrontendDist)/index.html')">
    <ItemGroup>
      <AtlasRentFrontendArchivo Include="$(AtlasRentFrontendDist)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AtlasRentFrontendArchivo)"
          DestinationFiles="@(AtlasRentFrontendArchivo->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Frontend incluido en el paquete desde $(AtlasRentFrontendDist)" />
  </Target>
</Project>