<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AtlasRent.Api</RootNamespace>
    <AssemblyName>AtlasRent.Api</AssemblyName>
    <!-- Credenciales de desarrollo en user-secrets (AGENTS.md §9); nunca en el repositorio -->
    <UserSecretsId>atlas-rent-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Fijado aquí para que la API y los tests resuelvan la misma versión de EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- F1-04: validación del JWT de acceso (viene en cookie) y hash de contraseñas -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="BCrypt.Net-Next" />
    <!-- F1-06: segundo factor TOTP -->
    <PackageReference Include="Otp.NET" />
    <!-- F1-12: servidor de jobs y su almacenamiento en PostgreSQL (DOC_TECNICA §8) -->
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- F1-12: fija la versión parcheada de Newtonsoft.Json para todo el grafo (ver
         Directory.Packages.props): Hangfire arrastra la 11.0.1, con CVE-2024-21907. -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AtlasRent.Tests" />
  </ItemGroup>
</Project>