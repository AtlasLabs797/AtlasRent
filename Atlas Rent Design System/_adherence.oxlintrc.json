{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/core/**",
              "components/data/**",
              "components/documents/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/workflow/**",
              "ui_kits/atlas-rent/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:agent|label|style|key|ref|className|style|children)$/]",
        "message": "<AgentBadge> doesn't accept that prop. Declared props: agent, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentBadge'] > JSXAttribute[name.name='agent'] > Literal[value!=/^(?:cobros|contratos|facturacion|operaciones|supervisor|migracion)$/]",
        "message": "<AgentBadge> agent must be one of 'cobros' | 'contratos' | 'facturacion' | 'operaciones' | 'supervisor' | 'migracion'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:actions|label|size|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<AIActionButton> doesn't accept that prop. Declared props: actions, label, size, onSelect, style."
